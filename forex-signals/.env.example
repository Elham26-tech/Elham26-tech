# Copy to .env (or set these in your host's environment) — never commit the real file.

# Claude API key. Without it the app still runs, with the rule engine only.
ANTHROPIC_API_KEY=

# Login for the web UI (HTTP Basic). If APP_PASSWORD is empty, a random one is
# generated on first start, printed to the console and kept in data/credentials.json.
APP_USER=admin
APP_PASSWORD=

# tradingview (live) or demo (simulated prices, for trying the app offline)
DATA_SOURCE=tradingview

PORT=3000
HOST=0.0.0.0

# Model settings. AI_FALLBACKS=off disables the server-side refusal fallback.
AI_MODEL=claude-opus-5
AI_EFFORT=high
AI_FALLBACKS=default

# Automatic analysis while the server is on (closed markets are skipped):
#   smart    = at each 1H candle close, only when price is on a zone or a breakout is in play
#   interval = every AUTO_ANALYZE_MINUTES for each instrument
#   off      = only from the button or a TradingView alert
# Every AI run is a paid API call.
AUTO_ANALYZE=smart
AUTO_ANALYZE_MINUTES=60
MIN_ANALYZE_SECONDS=30

# TradingView alerts → POST https://<DOMAIN>/api/webhook/tradingview
# Put the same secret in the Pine indicator's "Webhook secret" input. Empty = webhook off.
WEBHOOK_SECRET=

# Signals to Telegram: token from @BotFather, your chat id (see README).
# TELEGRAM_NOTIFY: actionable (buy/sell only), all, or off
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY=actionable

# Your domain, for docker compose --profile https (automatic HTTPS with Caddy)
DOMAIN=

# Optional: another TradingView symbol per instrument, e.g. TVC:GOLD or FX:EURUSD
# TV_SYMBOL_EURUSD=OANDA:EURUSD
# TV_SYMBOL_XAUUSD=OANDA:XAUUSD
# TV_SYMBOL_GBPJPY=OANDA:GBPJPY
# Optional: a TradingView session token from a logged-in account.
# TV_AUTH_TOKEN=

# Tutorials library budget (sent with every AI request, cached)
MAX_UPLOAD_MB=20
MAX_TUTORIAL_MB=20
MAX_TUTORIAL_CHARS=300000

RISK_PERCENT=1
DATA_DIR=data
